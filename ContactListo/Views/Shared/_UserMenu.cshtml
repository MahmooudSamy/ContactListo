@{
}


<div class="ml-auto">
    @if(User.Identity!=null &&User.Identity.IsAuthenticated)
    {
        <span class="navbar-text">Hello, @User.Identity.Name!</span>
        <a class="btn btn-danger ml-2" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
    }
    else
    {
        <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Login">Login</a>

    }
</div>